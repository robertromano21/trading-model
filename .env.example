# Copy to .env.local (gitignored) and fill in, or enter keys in the dashboard (Data keys / Schwab setup / AI keys).
# Never commit .env.local.

# Market data (massive.com). Also settable in Research & data > Data keys.
MASSIVE_API_KEY=
# FRED macro data (fredaccount.stlouisfed.org > API Keys). Also settable in Data keys.
FRED_API_KEY=

# Schwab developer app (developer.schwab.com). Also settable in the Schwab setup dialog.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the callback registered on your Schwab app exactly (separate from the dashboard port).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# AI analyst providers (optional; also settable in /ai.html > API keys).
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Optional SEC EDGAR contact string, e.g. "Your Name you@example.com".
SEC_USER_AGENT=

# Dashboard port (default 3003).
# PRICES_PORT=3003

# Optional: Piper voice model location (default <repo>/models/piper).
# TM_PIPER_DIR=

# Optional: AI analyst experiment paper accounts (ids 1000-9999).
# Soft cap on active experiment accounts (default 200).
# TM_MAX_USER_ACCOUNTS=200
# Concurrent experiment baseline backtests (default 2).
# TM_MAX_EXPERIMENT_BACKTESTS=2
